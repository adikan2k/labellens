# Copy to .env and fill in. Never commit .env.

# Models
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-haiku-5-5
MODEL_EVAL=claude-sonnet-5-5

# Embeddings (provider chosen in phase 0, see docs/decisions/0001-embeddings.md)
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-4-lite

# Neon Postgres
DATABASE_URL=
DATABASE_URL_READONLY=
DB_POOL_TIMEOUT=8

# API: comma-separated browser origins allowed to call it (the Vercel URL in production)
CORS_ORIGINS=http://localhost:3000

# Neo4j AuraDB Free
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Public demo limits
ASK_RATE_LIMIT_PER_HOUR=10
ASK_DAILY_SPEND_CAP_USD=0.50
ASK_TIMEOUT_SECONDS=45

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
